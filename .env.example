# Application
APP_NAME=desafio-backend-python-ai
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (used by docker-compose's "db" service and by the API)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=desafio
# Host port where Postgres is exposed (change it if 5433 is already in use)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/desafio
# Running the API outside Docker? Use the exposed port instead:
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/desafio

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS (frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# AI Agent - choose ONE option
# "test" = fake model, no API key, the agent calls tools with dummy data
LLM_MODEL=test
# Hides PydanticAI's startup banner in the logs
PYDANTIC_AI_NO_BANNER=1

# Ollama (free, local):
# LLM_MODEL=ollama:llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Gemini (has a free tier):
# LLM_MODEL=google:gemini-3.8-flash
# GOOGLE_API_KEY=your-gemini-api-key

# OpenAI:
# LLM_MODEL=openai:<model-name>
# OPENAI_API_KEY=your-openai-api-key
